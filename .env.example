VIDEO_TITLE_PREFIX=Top Tech News
NEWS_QUERY=India technology OR India startup OR India AI OR India policy
NEWS_REGION=IN
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
VOICE_NAME=en-IN-NeerjaNeural
# If Edge TTS fails, macOS `say` uses this voice (Indian English). Try Veena or Lekha; empty = system default.
MACOS_SAY_VOICE=Veena
# Looping reporter clip (optional). If set and the file exists, it wins over the image.
REPORTER_VIDEO_PATH=
# Portrait for on-screen anchor (PNG/JPG). Example after adding assets/reporter.png:
REPORTER_IMAGE_PATH=./assets/reporter.png
OUTPUT_DIR=./output
MAX_STORIES=3
# Target spoken length in seconds (shorter = faster TTS + FFmpeg). Typical: 45–90.
NARRATION_TARGET_SECONDS=45
MEMORY_FILE=./output/used_news.json
PUBLISH_TARGET=local
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
YOUTUBE_CLIENT_SECRETS=./credentials/client_secrets.json
YOUTUBE_TOKEN_FILE=./credentials/youtube_token.json
YOUTUBE_CATEGORY_ID=28
YOUTUBE_PRIVACY_STATUS=private
